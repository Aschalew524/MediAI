# Optional — copy to `.env.local` (gitignored) to test against LOCAL backend before deploy.
#
#   cp .env.local.example .env.local
#
# Then restart: npm run dev

# --- Easiest: flip this on/off (overrides NEXT_PUBLIC_API_URL) ---
NEXT_PUBLIC_USE_LOCAL_API=true

# --- Or set the API URL directly (leave USE_LOCAL_API unset) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production API (default in `.env` — do not need this in `.env.local` unless testing prod API locally)
# NEXT_PUBLIC_API_URL=https://medi-ai-backend.vercel.app/api

NEXT_PUBLIC_RAG_ENABLED=1
