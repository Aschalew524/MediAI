# NestJS API (global prefix /api)
# Production (Vercel): https://medi-ai-backend.vercel.app/api
NEXT_PUBLIC_API_URL=https://medi-ai-backend.vercel.app/api
# Optional local backend: cp .env.local.example .env.local → NEXT_PUBLIC_USE_LOCAL_API=true
# See docs/LOCAL_BACKEND.md

# Google sign-in button: set to "false" to hide (Nest still needs GOOGLE_* for OAuth to work).
# NEXT_PUBLIC_GOOGLE_SIGNIN=false

# Chat UI reads ragEnabled from Nest GET /api/chat/config when NEXT_PUBLIC_API_URL points at the backend.
# Set RAG_ENABLED=true on MediAI_backend (not required on the frontend).
# NEXT_PUBLIC_RAG_ENABLED is only used by the optional Next.js stub at src/app/api/chat/config/route.ts
